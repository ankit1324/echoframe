# Release signing credentials for Echoframe.
#
# Copy to `keystore.properties` at the repo root and fill in real values.
# `keystore.properties`, *.jks and *.keystore are git-ignored — never commit them.
#
# You create and hold the keystore yourself, e.g.:
#   keytool -genkeypair -v -keystore echoframe-release.jks \
#           -alias echoframe -keyalg RSA -keysize 4096 -validity 10000
#
# Keep the .jks and these passwords backed up somewhere safe: losing them means you
# can no longer publish updates to the same Play listing (unless Play App Signing
# is enabled and you can reset the upload key).
#
# If this file is absent, the build falls back to these environment variables:
#   ECHOFRAME_STORE_FILE, ECHOFRAME_STORE_PASSWORD, ECHOFRAME_KEY_ALIAS, ECHOFRAME_KEY_PASSWORD
# If neither is present, `assembleRelease` still runs but produces an UNSIGNED output;
# `assembleDebug` and the unit tests are unaffected.

# Path to the keystore. Relative paths resolve against the repo root.
storeFile=echoframe-release.jks

# Password of the keystore file.
storePassword=

# Alias of the key inside the keystore.
keyAlias=echoframe

# Password of that key (often the same as storePassword).
keyPassword=
